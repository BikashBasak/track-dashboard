# Optional: country/language defaults
PLAY_DEFAULT_COUNTRY=us
PLAY_DEFAULT_LANG=en

# Neon Postgres (required on hosted deploys for durable tracking history / timeline)
# Create a free DB at https://console.neon.tech and paste the connection string.
DATABASE_URL=

# Dashboard login password (required on production for the lock screen)
DASHBOARD_PASSWORD=

# --- Official paid providers (use YOUR subscribed keys only) ---
# Never paste keys stolen from another product. See README.

# AsoSpy does not publish a developer API. Do not put stolen apivector keys here.

# Sensor Tower Connect API (https://app.sensortower.com/)
SENSORTOWER_API_TOKEN=

# AppTweak API (https://www.apptweak.com/)
APPTWEAK_API_KEY=

# 42matters / Similarweb App Intelligence
FORTYTWOMATTERS_ACCESS_TOKEN=

# Appfigures
APPFIGURES_CLIENT_KEY=
APPFIGURES_CLIENT_SECRET=

# Google Play Developer API (only for apps YOU own)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=